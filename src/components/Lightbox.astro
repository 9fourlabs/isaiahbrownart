---
// One shared, accessible lightbox. Any element with data-lb="<group>" opens it.
// Data attributes: data-type ("image" | "video"), data-src, data-title, data-desc, data-meta, data-commission
import site from '../content/site.json';
---
<dialog class="lb" aria-labelledby="lb-title">
  <div class="lb-inner">
    <button class="lb-close" type="button" aria-label="Close">
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
    </button>
    <div class="lb-media"></div>
    <div class="lb-caption">
      <div>
        <h2 id="lb-title"></h2>
        <p class="lb-desc"></p>
        <p class="lb-meta"></p>
        <p class="lb-commission" hidden>
          {site.commissionNote} <a href="/contact/">Commission this →</a>
        </p>
      </div>
      <div class="lb-nav">
        <button class="lb-prev" type="button" aria-label="Previous piece">←</button>
        <span class="lb-count" aria-live="polite"></span>
        <button class="lb-next" type="button" aria-label="Next piece">→</button>
      </div>
    </div>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lb')!;
  const media = dialog.querySelector<HTMLElement>('.lb-media')!;
  const title = dialog.querySelector<HTMLElement>('#lb-title')!;
  const desc = dialog.querySelector<HTMLElement>('.lb-desc')!;
  const meta = dialog.querySelector<HTMLElement>('.lb-meta')!;
  const commission = dialog.querySelector<HTMLElement>('.lb-commission')!;
  const count = dialog.querySelector<HTMLElement>('.lb-count')!;
  const nav = dialog.querySelector<HTMLElement>('.lb-nav')!;

  let items: HTMLElement[] = [];
  let index = 0;
  let opener: HTMLElement | null = null;

  function show(i: number) {
    index = (i + items.length) % items.length;
    const el = items[index];
    const d = el.dataset;
    media.replaceChildren();

    if (d.type === 'video') {
      const frame = document.createElement('iframe');
      frame.src = d.src!;
      frame.title = d.title || 'Video';
      frame.allow = 'autoplay; fullscreen; picture-in-picture; encrypted-media';
      frame.allowFullscreen = true;
      frame.className = 'lb-video';
      media.append(frame);
    } else {
      const img = document.createElement('img');
      img.src = d.src!;
      img.alt = d.alt || d.title || '';
      img.className = 'lb-img';
      media.append(img);
    }

    title.textContent = d.title || '';
    desc.textContent = d.desc || '';
    desc.hidden = !d.desc;
    meta.textContent = d.meta || '';
    meta.hidden = !d.meta;
    commission.hidden = d.commission !== 'true';
    count.textContent = `${index + 1} / ${items.length}`;
    nav.hidden = items.length < 2;
  }

  document.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-lb]');
    if (!el) return;
    e.preventDefault();
    items = [...document.querySelectorAll<HTMLElement>(`[data-lb="${el.dataset.lb}"]`)];
    opener = el;
    show(items.indexOf(el));
    dialog.showModal();
    dialog.querySelector<HTMLButtonElement>('.lb-close')!.focus();
  });

  dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
  dialog.querySelector('.lb-prev')!.addEventListener('click', () => show(index - 1));
  dialog.querySelector('.lb-next')!.addEventListener('click', () => show(index + 1));

  // Click on the dark backdrop closes it
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  dialog.addEventListener('keydown', (e) => {
    if (items.length < 2) return;
    if (e.key === 'ArrowRight') show(index + 1);
    if (e.key === 'ArrowLeft') show(index - 1);
  });

  dialog.addEventListener('close', () => {
    media.replaceChildren(); // stops any playing video
    opener?.focus();
  });
</script>

<style is:global>
  dialog.lb {
    width: min(1200px, 100vw - 24px);
    max-height: calc(100vh - 24px);
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    overflow: auto;
  }
  dialog.lb::backdrop { background: rgb(0 0 0 / 0.85); }
  .lb-inner { position: relative; }
  .lb-close {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: rgb(0 0 0 / 0.6);
    color: #fff;
    display: grid;
    place-items: center;
    cursor: pointer;
  }
  .lb-close:hover { background: var(--accent); color: var(--accent-ink); }
  .lb-media { background: #000; display: grid; place-items: center; }
  .lb-img { max-height: 68vh; width: auto; height: auto; object-fit: contain; }
  .lb-video { width: 100%; aspect-ratio: 16 / 9; border: 0; }
  .lb-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: flex-start;
    padding: 18px 20px 20px;
  }
  .lb-caption h2 { font-size: 1.4rem; margin: 0 0 4px; }
  .lb-caption p { margin: 0 0 6px; color: var(--muted); max-width: 70ch; }
  .lb-caption .lb-commission { color: var(--text); margin-top: 10px; }
  .lb-nav { display: flex; align-items: center; gap: 10px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .lb-nav button {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    font-size: 1.2rem;
    cursor: pointer;
  }
  .lb-nav button:hover { border-color: var(--accent); color: var(--accent); }
</style>
