---
import '../styles/global.css';
import site from '../content/site.json';
import Lightbox from '../components/Lightbox.astro';

interface Props { title?: string; description?: string; }
const { title, description = site.tagline } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Animator & Maker`;

const nav = [
  { href: '/animation/', label: 'Animation' },
  { href: '/art/', label: 'Art' },
  { href: '/made-by-hand/', label: 'Made by Hand' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const here = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0b0f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(here, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/work/' + site.heroPoster, Astro.site)} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="logo" href="/" aria-label={`${site.name}, home`}>
          {site.name.split(' ')[0]}<span>.</span>
        </a>
        <button class="menu-btn" aria-expanded="false" aria-controls="site-nav">
          <span class="visually-hidden">Menu</span>
          <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
        </button>
        <nav id="site-nav" aria-label="Main">
          <ul>
            {nav.map((n) => (
              <li><a href={n.href} aria-current={here.startsWith(n.href) ? 'page' : undefined}>{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap foot">
        <p>© {new Date().getFullYear()} {site.name}</p>
        <ul>
          <li><a href={site.links.instagram} rel="me noopener">Instagram</a></li>
          <li><a href={site.links.youtube} rel="me noopener">YouTube</a></li>
          <li><a href={site.links.etsy} rel="noopener">Etsy</a></li>
        </ul>
      </div>
    </footer>

    <Lightbox />

    <script>
      const btn = document.querySelector<HTMLButtonElement>('.menu-btn')!;
      const nav = document.getElementById('site-nav')!;
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        nav.classList.toggle('open', !open);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && nav.classList.contains('open')) {
          nav.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
          btn.focus();
        }
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(11 11 15 / 0.85);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .logo {
    color: var(--text);
    font-weight: 900;
    font-size: 1.5rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: -0.03em;
  }
  .logo span { color: var(--accent); }
  .menu-btn {
    background: none;
    border: 0;
    color: var(--text);
    padding: 10px;
    margin-right: -10px;
    cursor: pointer;
  }
  nav ul { list-style: none; margin: 0; padding: 0; }
  nav a {
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    display: block;
    padding: 12px 0;
  }
  nav a:hover, nav a[aria-current='page'] { color: var(--accent); }

  /* Mobile: dropdown menu */
  #site-nav {
    display: none;
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding: 8px var(--gutter) 16px;
  }
  #site-nav.open { display: block; }
  #site-nav a { font-size: 1.25rem; }

  @media (min-width: 820px) {
    .menu-btn { display: none; }
    #site-nav { display: block; position: static; padding: 0; border: 0; background: none; }
    nav ul { display: flex; gap: 28px; }
    #site-nav a { font-size: 0.95rem; padding: 8px 0; }
  }

  main:focus { outline: none; }

  .site-footer { border-top: 1px solid var(--line); margin-top: 80px; color: var(--muted); font-size: 0.95rem; }
  .foot { display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; align-items: center; padding-block: 24px; }
  .foot p { margin: 0; }
  .foot ul { list-style: none; display: flex; gap: 20px; margin: 0; padding: 0; }
  .foot a { color: var(--muted); }
  .foot a:hover { color: var(--accent); }
</style>
