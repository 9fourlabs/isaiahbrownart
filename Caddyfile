{
	admin off
	auto_https off
}

# Fly.io handles HTTPS in front of this; Caddy just serves the built site.
:8080 {
	# Send www.isaiahbrown.art to isaiahbrown.art
	@www host www.isaiahbrown.art
	redir @www https://isaiahbrown.art{uri} permanent

	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		-Server
	}

	# Hashed build files and thumbnails can be cached for a long time
	@immutable path /_astro/* /thumbs/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@work path /work/*
	header @work Cache-Control "public, max-age=86400"

	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
